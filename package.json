{
  "name": "@universal-ui/engine",
  "version": "2.0.0",
  "type": "module",
  "description": "Portable UI Engine - Framework-Agnostic Web Components Asset Library with Shadow DOM Isolation & AI Gateway Contracts",
  "main": "./dist/engine.min.js",
  "module": "./dist/engine.js",
  "exports": {
    ".": {
      "import": "./dist/engine.js",
      "default": "./dist/engine.min.js"
    },
    "./theme.css": "./theme.css"
  },
  "files": [
    "dist/",
    "theme.css",
    "engine.js",
    "elements/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node build.js && vite build",
    "build:engine": "node build.js",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "test": "wtr tests/**/*.test.js --node-resolve --playwright",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@web/test-runner": "^0.18.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
